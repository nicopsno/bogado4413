<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portal Obra — Bogado 4413</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f4f5f7;min-height:100vh;color:#1a1a2e}
a{color:inherit;text-decoration:none}

/* LOGIN */
#login-page{display:flex;align-items:center;justify-content:center;min-height:100vh;background:#f4f5f7}
#login-page.hidden{display:none}
.login-card{background:#fff;border:1px solid #e2e5ec;border-radius:12px;padding:2.5rem 2rem;width:360px;box-shadow:0 2px 16px rgba(0,0,0,0.07)}
.login-logo{font-size:10px;letter-spacing:.14em;color:#8a94a6;text-transform:uppercase;margin-bottom:6px}
.login-title{font-size:22px;font-weight:600;color:#1a2744;margin-bottom:4px}
.login-sub{font-size:13px;color:#8a94a6;margin-bottom:2rem}
.field-group{margin-bottom:1rem}
.field-label{display:block;font-size:12px;color:#5a6478;margin-bottom:5px;font-weight:500}
.login-card input{width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;background:#fff;color:#1a2744;outline:none;transition:border .15s}
.login-card input:focus{border-color:#3b5998}
.login-btn{width:100%;padding:11px;background:#1a2744;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-top:.5rem;transition:background .15s}
.login-btn:hover{background:#243560}
.login-error{font-size:12px;color:#dc2626;margin-top:8px;min-height:18px}

/* LAYOUT */
#main-page{display:flex;min-height:100vh}
#main-page.hidden{display:none}
.sidebar{width:230px;min-width:230px;background:#1a2744;display:flex;flex-direction:column;padding:1.5rem 0;position:fixed;top:0;left:0;height:100vh;z-index:10}
.sidebar-brand{padding:0 1.25rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.1)}
.sidebar-brand-label{font-size:10px;letter-spacing:.12em;color:rgba(255,255,255,.4);text-transform:uppercase}
.sidebar-brand-name{font-size:16px;font-weight:600;color:#fff;margin-top:3px}
.sidebar-nav{padding:1rem 0;flex:1;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 1.25rem;cursor:pointer;color:rgba(255,255,255,.6);font-size:13px;border-left:3px solid transparent;transition:all .15s}
.nav-item:hover{color:#fff;background:rgba(255,255,255,.07)}
.nav-item.active{color:#fff;border-left-color:#6fa8dc;background:rgba(255,255,255,.1)}
.nav-item i{font-size:17px}
.sidebar-user{padding:1rem 1.25rem;border-top:1px solid rgba(255,255,255,.1);display:flex;align-items:center;gap:10px}
.user-avatar{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#fff;flex-shrink:0}
.user-name{font-size:12px;color:rgba(255,255,255,.8);flex:1}
.logout-btn{background:none;border:none;cursor:pointer;color:rgba(255,255,255,.4);font-size:16px;padding:4px}
.logout-btn:hover{color:#fff}

.content{flex:1;margin-left:230px;padding:1.75rem;min-height:100vh;background:#f4f5f7}
.content-header{margin-bottom:1.5rem;display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px}
.content-title{font-size:22px;font-weight:600;color:#1a2744}
.content-sub{font-size:13px;color:#8a94a6;margin-top:3px}

/* TABS */
.tab-section{display:none}
.tab-section.active{display:block}

/* METRICS */
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:1.5rem}
.metric-card{background:#fff;border:1px solid #e2e5ec;border-radius:10px;padding:1.1rem 1.25rem}
.metric-label{font-size:11px;color:#8a94a6;text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px;font-weight:500}
.metric-value{font-size:24px;font-weight:600;color:#1a2744}
.metric-value.green{color:#16a34a}
.metric-value.red{color:#dc2626}
.metric-value.blue{color:#2563eb}
.metric-value.orange{color:#d97706}
.metric-sub{font-size:11px;color:#b0b8c8;margin-top:4px}

/* SECTION CARD */
.section-card{background:#fff;border:1px solid #e2e5ec;border-radius:12px;padding:1.25rem;margin-bottom:1rem;overflow-x:auto}
.section-card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:8px}
.section-card-title{font-size:14px;font-weight:600;color:#1a2744}

/* BUTTONS */
.action-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:#1a2744;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s;white-space:nowrap}
.action-btn:hover{background:#243560}
.action-btn.secondary{background:#fff;color:#1a2744;border:1px solid #d1d5db}
.action-btn.secondary:hover{background:#f4f5f7}

/* TABLE */
.data-table{width:100%;border-collapse:collapse;font-size:13px;min-width:500px}
.data-table th{text-align:left;padding:8px 12px;font-size:11px;font-weight:600;color:#8a94a6;border-bottom:1px solid #e2e5ec;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}
.data-table td{padding:11px 12px;border-bottom:1px solid #f0f2f5;color:#1a2744;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.data-table tr:last-child td{border-bottom:none}
.data-table tbody tr:hover td{background:#f8f9fb}

/* BADGES */
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
.badge-success{background:#dcfce7;color:#15803d}
.badge-warning{background:#fef3c7;color:#b45309}
.badge-info{background:#dbeafe;color:#1d4ed8}
.badge-danger{background:#fee2e2;color:#b91c1c}
.badge-gray{background:#f1f5f9;color:#475569}

/* PROGRESS */
.progress-wrap{margin-top:8px}
.progress-bar-bg{height:8px;background:#e2e5ec;border-radius:4px;overflow:hidden}
.progress-bar-fill{height:100%;background:linear-gradient(90deg,#1a2744,#3b5998);border-radius:4px;transition:width .6s ease}
.progress-label{font-size:12px;color:#8a94a6;margin-top:6px}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:flex-start;justify-content:center;padding-top:60px;overflow-y:auto}
.modal-overlay.open{display:flex}
.modal{background:#fff;border-radius:14px;padding:1.75rem;width:480px;max-width:95vw;margin-bottom:40px}
.modal-title{font-size:17px;font-weight:600;color:#1a2744;margin-bottom:1.5rem}
.form-row{margin-bottom:1rem}
.form-row label{display:block;font-size:12px;color:#5a6478;margin-bottom:5px;font-weight:500}
.form-row input,.form-row select,.form-row textarea{width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;background:#fff;color:#1a2744;outline:none;transition:border .15s;font-family:inherit}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{border-color:#3b5998}
.form-row textarea{resize:vertical;min-height:72px}
.form-row-inline{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:1.5rem}
.anulacion-ref{display:none}

/* PLANOS */
.planos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}
.plano-card{background:#fff;border:1px solid #e2e5ec;border-radius:12px;overflow:hidden}
.plano-thumb{background:#f0f4f8;height:140px;display:flex;align-items:center;justify-content:center;color:#8a94a6;font-size:40px;border-bottom:1px solid #e2e5ec}
.plano-info{padding:12px 14px}
.plano-name{font-size:13px;font-weight:600;color:#1a2744}
.plano-detail{font-size:11px;color:#8a94a6;margin-top:3px}

/* EMPTY STATE */
.empty-state{text-align:center;padding:3rem 1rem;color:#b0b8c8}
.empty-state i{font-size:36px;display:block;margin-bottom:10px;opacity:.5}
.empty-state p{font-size:13px}

/* AUDIT ROW */
.audit-ts{font-size:11px;color:#8a94a6;white-space:nowrap}

/* RESPONSIVE */
@media(max-width:768px){
  .sidebar{width:200px}
  .content{margin-left:200px;padding:1.25rem}
  .form-row-inline{grid-template-columns:1fr}
}
</style>
</head>
