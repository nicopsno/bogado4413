function renderFacturas() {
  const tbody = document.getElementById('facturas-tbody');
  const sorted = [...DB.facturas].sort((a,b) => b.ts.localeCompare(a.ts));
  if(!sorted.length) {
    tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="ti ti-file-invoice"></i><p>Sin facturas cargadas</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = sorted.map(f => `
    <tr>
      <td>${fmtDate(f.fecha)}</td>
      <td title="${f.proveedor}">${f.proveedor}</td>
      <td title="${f.descripcion}">${f.descripcion}</td>
      <td>${fmtMoney(f.monto)}</td>
      <td>${f.nroFactura || '—'}</td>
