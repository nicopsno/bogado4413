<script>
// ─── USUARIOS ──────────────────────────────────────────────
// Para cambiar contraseñas: modificar estos valores directamente
const USERS = {
  "manu":  { pass: "obra2024",    display: "Manu",  initials: "MA" },
  "nico":  { pass: "bogado4413",  display: "Nico",  initials: "NI" }
};

const PRESUPUESTO_TOTAL = 50000000; // Modificar cuando esté definido

// ─── ESTADO ────────────────────────────────────────────────
let currentUser = null;
let currentModalType = null;

const DB = {
  gastos:   [],
  aportes:  [],
  facturas: [],
  audit:    []
};

// ─── PERSISTENCIA ──────────────────────────────────────────
function loadDB() {
  ['gastos','aportes','facturas','audit'].forEach(k => {
    try { DB[k] = JSON.parse(localStorage.getItem('ob4413_' + k) || '[]'); } catch(e) { DB[k] = []; }
  });
}
function saveDB(key) {
  try { localStorage.setItem('ob4413_' + key, JSON.stringify(DB[key])); } catch(e) {}
}

// ─── UTILS ─────────────────────────────────────────────────
function fmtMoney(n) {
  return '$\u00a0' + Number(n).toLocaleString('es-AR', {minimumFractionDigits:0, maximumFractionDigits:0});
}
function fmtDate(iso) {
  if(!iso) return '—';
  const [y,m,d] = iso.split('-');
  return d + '/' + m + '/' + y;
}
function fmtDatetime(iso) {
  if(!iso) return '—';
  return iso.replace('T',' ').substring(0,16);
}
function nowISO() { return new Date().toISOString(); }
function todayISO() { return new Date().toISOString().substring(0,10); }
function genId() { return Date.now() + '_' + Math.random().toString(36).substr(2,5); }

// ─── AUTH ──────────────────────────────────────────────────
loadDB();

function doLogin() {
  const u = document.getElementById('login-user').value.trim().toLowerCase();
  const p = document.getElementById('login-pass').value;
  const err = document.getElementById('login-error');
  if (USERS[u] && USERS[u].pass === p) {
    currentUser = { id: u, ...USERS[u] };
    document.getElementById('user-display').textContent = currentUser.display;
    document.getElementById('user-initials').textContent = currentUser.initials;
    document.getElementById('login-page').classList.add('hidden');
    document.getElementById('main-page').classList.remove('hidden');
    renderAll();
  } else {
    err.textContent = 'Usuario o contraseña incorrectos.';
  }
}

function doLogout() {
  currentUser = null;
  document.getElementById('main-page').classList.add('hidden');
  document.getElementById('login-page').classList.remove('hidden');
  document.getElementById('login-user').value = '';
  document.getElementById('login-pass').value = '';
  document.getElementById('login-error').textContent = '';
}

document.getElementById('login-pass').addEventListener('keydown', e => {
  if(e.key === 'Enter') doLogin();
});
document.getElementById('login-user').addEventListener('keydown', e => {
  if(e.key === 'Enter') document.getElementById('login-pass').focus();
});

// ─── NAVEGACIÓN ────────────────────────────────────────────
function showTab(name, el) {
  document.querySelectorAll('.tab-section').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  if(el) el.classList.add('active');
  if(name === 'dashboard') renderDashboard();
}

// ─── RENDER ────────────────────────────────────────────────
function renderAll() {
  renderDashboard();
  renderGastos();
  renderAportes();
  renderFacturas();
  renderAudit();
}

function renderDashboard() {
  const gastosActivos = DB.gastos.filter(g => !g.anulado);
  const aportesActivos = DB.aportes.filter(a => !a.anulado);
  const totalGastado = gastosActivos.reduce((s,g) => s + Number(g.monto), 0);
  const totalAportado = aportesActivos.reduce((s,a) => s + Number(a.monto), 0);
  const saldo = totalAportado - totalGastado;
  const pendiente = PRESUPUESTO_TOTAL - totalGastado;
  const pct = PRESUPUESTO_TOTAL > 0 ? Math.min(100, Math.round(totalGastado / PRESUPUESTO_TOTAL * 100)) : 0;

  document.getElementById('metrics-grid').innerHTML = `
    <div class="metric-card">
      <div class="metric-label">Total aportado</div>
      <div class="metric-value green">${fmtMoney(totalAportado)}</div>
      <div class="metric-sub">${aportesActivos.length} aportes activos</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Total gastado</div>
      <div class="metric-value red">${fmtMoney(totalGastado)}</div>
      <div class="metric-sub">${gastosActivos.length} gastos activos</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Saldo disponible</div>
      <div class="metric-value ${saldo >= 0 ? 'blue' : 'red'}">${fmtMoney(saldo)}</div>
      <div class="metric-sub">aportado − gastado</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Saldo presupuesto</div>
      <div class="metric-value ${pendiente >= 0 ? 'orange' : 'red'}">${fmtMoney(pendiente)}</div>
      <div class="metric-sub">de $${(PRESUPUESTO_TOTAL/1000000).toFixed(1)}M estimados</div>
    </div>
  `;

  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-pct-badge').textContent = pct + '%';
  document.getElementById('progress-label').textContent =
    pct > 0
      ? fmtMoney(totalGastado) + ' gastados de ' + fmtMoney(PRESUPUESTO_TOTAL) + ' presupuestados'
      : 'Cargá el primer movimiento para ver el avance';

  const all = [
    ...DB.gastos.map(g => ({...g, _tipo:'Gasto'})),
    ...DB.aportes.map(a => ({...a, _tipo:'Aporte'}))
  ].sort((a,b) => b.ts.localeCompare(a.ts)).slice(0,10);

  const tbody = document.getElementById('recent-tbody');
  if(!all.length) {
    tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><i class="ti ti-inbox"></i><p>Sin movimientos aún</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = all.map(r => `
    <tr>
      <td>${fmtDate(r.fecha)}</td>
      <td><span class="badge ${r._tipo==='Aporte' ? 'badge-success' : 'badge-info'}">${r._tipo}</span></td>
      <td title="${r.descripcion}">${r.descripcion}</td>
      <td>${fmtMoney(r.monto)}</td>
      <td>${r.anulado ? '<span class="badge badge-danger">Anulado</span>' : '<span class="badge badge-success">Activo</span>'}</td>
    </tr>`).join('');
}

function renderGastos() {
  const tbody = document.getElementById('gastos-tbody');
  const sorted = [...DB.gastos].sort((a,b) => b.ts.localeCompare(a.ts));
  if(!sorted.length) {
    tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="ti ti-receipt"></i><p>Sin gastos registrados</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = sorted.map(g => `
    <tr>
      <td>${fmtDate(g.fecha)}</td>
      <td title="${g.descripcion}">${g.descripcion}</td>
      <td>${g.categoria || '—'}</td>
      <td>${fmtMoney(g.monto)}</td>
      <td>${g.sinFactura ? '<span class="badge badge-warning">Sin factura</span>' : '<span class="badge badge-gray">Con factura</span>'}</td>
      <td>${g.anulado ? '<span class="badge badge-danger">Anulado</span>' : '<span class="badge badge-success">Activo</span>'}</td>
    </tr>`).join('');
}

function renderAportes() {
  const tbody = document.getElementById('aportes-tbody');
  const sorted = [...DB.aportes].sort((a,b) => b.ts.localeCompare(a.ts));
