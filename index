function renderAudit() {
  const tbody = document.getElementById('audit-tbody');
  const sorted = [...DB.audit].sort((a,b) => b.ts.localeCompare(a.ts));
  if(!sorted.length) {
    tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><i class="ti ti-list-check"></i><p>Sin registros en auditoría</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = sorted.map(a => `
    <tr>
      <td class="audit-ts">${fmtDatetime(a.ts)}</td>
      <td>${a.usuario}</td>
      <td><span class="badge badge-info">${a.tipo}</span></td>
      <td title="${a.detalle}" style="font-size:12px">${a.detalle}</td>
      <td>${a.monto ? fmtMoney(a.monto) : '—'}</td>
    </tr>`).join('');
}

// ─── MODAL ─────────────────────────────────────────────────
function handleOverlayClick(e) {
  if(e.target === document.getElementById('modal-overlay')) closeModal();
}

function openModal(type) {
  currentModalType = type;
  const title = document.getElementById('modal-title');
  const body = document.getElementById('modal-body');
  const CATS = ['Materiales','Mano de obra','Equipos','Honorarios','Administrativo','Servicios','Otro'];

  if(type === 'gasto') {
    title.textContent = 'Registrar nuevo gasto';
    body.innerHTML = `
      <div class="form-row-inline">
        <div class="form-row"><label>Fecha *</label><input type="date" id="f-fecha" value="${todayISO()}"></div>
        <div class="form-row"><label>Monto ($) *</label><input type="number" id="f-monto" placeholder="0" min="0"></div>
      </div>
      <div class="form-row"><label>Descripción *</label><input type="text" id="f-desc" placeholder="Ej: Compra de hierro — 500 kg"></div>
      <div class="form-row-inline">
        <div class="form-row"><label>Categoría</label>
          <select id="f-cat">${CATS.map(c=>`<option>${c}</option>`).join('')}</select>
        </div>
        <div class="form-row"><label>¿Sin factura?</label>
          <select id="f-sinfactura"><option value="no">No — tiene factura</option><option value="si">Sí — gasto sin factura</option></select>
        </div>
      </div>
      <div class="form-row"><label>¿Es una anulación de carga anterior?</label>
        <select id="f-anulacion" onchange="toggleAnulRef(this)"><option value="no">No</option><option value="si">Sí</option></select>
      </div>
      <div class="form-row anulacion-ref" id="anul-ref-row">
        <label>Referencia de la carga anulada *</label>
        <input type="text" id="f-anulref" placeholder="Ej: ANULACIÓN carga 2024-001">
      </div>
      <div class="form-row"><label>Observaciones</label><textarea id="f-obs" placeholder="Notas adicionales..."></textarea></div>
    `;
  } else if(type === 'aporte') {
    title.textContent = 'Registrar nuevo aporte';
    body.innerHTML = `
      <div class="form-row-inline">
        <div class="form-row"><label>Fecha *</label><input type="date" id="f-fecha" value="${todayISO()}"></div>
        <div class="form-row"><label>Monto ($) *</label><input type="number" id="f-monto" placeholder="0" min="0"></div>
      </div>
      <div class="form-row"><label>Inversor *</label><input type="text" id="f-inversor" placeholder="Nombre del inversor o entidad"></div>
      <div class="form-row"><label>Descripción *</label><input type="text" id="f-desc" placeholder="Ej: Cuota 3 — junio 2025"></div>
      <div class="form-row"><label>¿Es una anulación de carga anterior?</label>
        <select id="f-anulacion" onchange="toggleAnulRef(this)"><option value="no">No</option><option value="si">Sí</option></select>
      </div>
      <div class="form-row anulacion-ref" id="anul-ref-row">
        <label>Referencia de la carga anulada *</label>
        <input type="text" id="f-anulref" placeholder="Ej: ANULACIÓN aporte 2024-003">
      </div>
      <div class="form-row"><label>Observaciones</label><textarea id="f-obs" placeholder="Notas adicionales..."></textarea></div>
    `;
  } else if(type === 'factura') {
    title.textContent = 'Cargar factura';
    body.innerHTML = `
      <div class="form-row-inline">
        <div class="form-row"><label>Fecha *</label><input type="date" id="f-fecha" value="${todayISO()}"></div>
        <div class="form-row"><label>Monto ($) *</label><input type="number" id="f-monto" placeholder="0" min="0"></div>
      </div>
      <div class="form-row-inline">
        <div class="form-row"><label>Proveedor *</label><input type="text" id="f-prov" placeholder="Nombre del proveedor"></div>
        <div class="form-row"><label>N° Factura</label><input type="text" id="f-nrofac" placeholder="Ej: A-0001-00012345"></div>
      </div>
      <div class="form-row"><label>Descripción *</label><input type="text" id="f-desc" placeholder="Ej: Materiales de construcción — lote 3"></div>
      <div class="form-row"><label>¿Es una anulación de carga anterior?</label>
        <select id="f-anulacion" onchange="toggleAnulRef(this)"><option value="no">No</option><option value="si">Sí</option></select>
      </div>
      <div class="form-row anulacion-ref" id="anul-ref-row">
        <label>Referencia de la factura anulada *</label>
        <input type="text" id="f-anulref" placeholder="Ej: ANULACIÓN factura A-0001-00012345">
      </div>
      <div class="form-row"><label>Observaciones</label><textarea id="f-obs" placeholder="Notas adicionales..."></textarea></div>
    `;
  }

  document.getElementById('modal-overlay').classList.add('open');
  setTimeout(() => { const el = document.getElementById('f-desc') || document.getElementById('f-inversor'); if(el) el.focus(); }, 100);
}

function toggleAnulRef(sel) {
  const row = document.getElementById('anul-ref-row');
  if(row) row.style.display = sel.value === 'si' ? 'block' : 'none';
}

function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open');
  currentModalType = null;
}

function submitModal() {
  const t = currentModalType;
  const ts = nowISO();
  const fecha = document.getElementById('f-fecha')?.value;
  const monto = document.getElementById('f-monto')?.value;
  const desc = document.getElementById('f-desc')?.value.trim();
  const esAnulacion = document.getElementById('f-anulacion')?.value === 'si';
  const anulref = esAnulacion ? (document.getElementById('f-anulref')?.value.trim() || '') : '';
  const obs = document.getElementById('f-obs')?.value.trim() || '';

  if(!fecha) { alert('Completá la fecha.'); return; }
  if(!monto || Number(monto) <= 0) { alert('Ingresá un monto válido.'); return; }
  if(!desc) { alert('Completá la descripción.'); return; }
  if(esAnulacion && !anulref) { alert('Indicá la referencia de la carga que estás anulando.'); return; }

  const detalle = esAnulacion ? `ANULACIÓN: ${desc} (ref: ${anulref})` : desc;
  const id = genId();

  if(t === 'gasto') {
    const cat = document.getElementById('f-cat')?.value;
    const sinFac = document.getElementById('f-sinfactura')?.value === 'si';
    DB.gastos.push({ id, ts, fecha, descripcion: detalle, categoria: cat, monto: Number(monto), sinFactura: sinFac, anulado: esAnulacion, obs, usuario: currentUser.id });
    saveDB('gastos');
    renderGastos();
  } else if(t === 'aporte') {
    const inv = document.getElementById('f-inversor')?.value.trim() || '';
    if(!inv) { alert('Completá el nombre del inversor.'); return; }
    DB.aportes.push({ id, ts, fecha, descripcion: detalle, inversor: inv, monto: Number(monto), anulado: esAnulacion, obs, usuario: currentUser.id });
    saveDB('aportes');
    renderAportes();
  } else if(t === 'factura') {
    const prov = document.getElementById('f-prov')?.value.trim() || '';
    const nro = document.getElementById('f-nrofac')?.value.trim() || '';
    if(!prov) { alert('Completá el nombre del proveedor.'); return; }
    DB.facturas.push({ id, ts, fecha, proveedor: prov, descripcion: detalle, monto: Number(monto), nroFactura: nro, anulado: esAnulacion, obs, usuario: currentUser.id });
    saveDB('facturas');
    renderFacturas();
  }

  DB.audit.push({ ts, usuario: currentUser.display, tipo: t.charAt(0).toUpperCase() + t.slice(1), detalle, monto: Number(monto) });
  saveDB('audit');

  renderDashboard();
  renderAudit();
  closeModal();
}
</script>
